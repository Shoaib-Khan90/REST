<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Quora Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Quora Post</h1>

    <% for (let post of posts) { %>

        <div>
            <h3><%= post.username %></h3>
            <p><%= post.content %></p>
        </div>

    <% } %>

    <br>
    <br>
     <br>
    <br>
    <a href="http://localhost:3000/posts/new">Create New Post</a>
</body>
</html>